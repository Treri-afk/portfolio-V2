# Copier en .env (jamais versionné). Validé par Zod au démarrage (src/env.ts).
# Port local : nginx relaie /v1/ vers 127.0.0.1:PORT.
PORT=3000
# Origine du site autorisée par CORS (https en production).
ALLOWED_ORIGIN=http://localhost:5173
# Compte Gmail qui envoie. SMTP_PASS est un mot de passe d'application
# (Compte Google > Sécurité > Validation en deux étapes > Mots de passe des applications).
SMTP_USER=
SMTP_PASS=
# Adresse qui reçoit les messages du formulaire.
CONTACT_TO=
