{
  "name": "portfolio-v2",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=24.4.0"
  },
  "scripts": {
    "dev": "npm run tokens:build && npm run dev -w @portfolio/web",
    "dev:api": "npm run dev -w @portfolio/api",
    "build": "npm run tokens:build && npm run build -w @portfolio/web",
    "preview": "npm run preview -w @portfolio/web",
    "tokens:build": "npm run build -w @portfolio/tokens",
    "typecheck": "npm run tokens:build && tsc -p tsconfig.json && npm run typecheck --workspaces --if-present",
    "lint": "npm run tokens:build && npm run typegen -w @portfolio/web && npm run lint:js && npm run lint:css",
    "lint:js": "eslint .",
    "lint:css": "stylelint \"**/*.css\"",
    "test": "npm run tokens:build && vitest run",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "5.24.10",
    "@eslint/js": "10.0.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/culori": "4.0.1",
    "culori": "4.0.2",
    "eslint": "10.12.0",
    "eslint-plugin-boundaries": "7.2.0",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "29.1.1",
    "stylelint": "17.16.0",
    "stylelint-config-css-modules": "4.6.0",
    "stylelint-config-standard": "40.0.0",
    "stylelint-declaration-strict-value": "1.12.1",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  },
  "overrides": {
    "handlebars": "4.7.10"
  }
}
