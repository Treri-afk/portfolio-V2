{
  "slice": {
    "padding-block": {
      "$type": "dimension",
      "$value": "{layout.section}"
    },
    "page-inline": {
      "$type": "dimension",
      "$value": "{layout.page-inline}"
    }
  },
  "slant-rule": {
    "length": {
      "$type": "dimension",
      "$value": "{space.20}"
    },
    "weight": {
      "$type": "dimension",
      "$value": "{border.heavy}"
    },
    "color": {
      "$type": "color",
      "$value": "{color.accent.default}"
    },
    "angle": {
      "$type": "other",
      "$value": "{angle.rule.rise-base}"
    }
  },
  "page-transition": {
    "skew": {
      "$type": "dimension",
      "$value": "calc({layout.viewport-block} * tan({angle.transition.page}))"
    }
  },
  "button": {
    "height": {
      "$type": "dimension",
      "$value": "{layout.target}"
    },
    "padding-inline": {
      "$type": "dimension",
      "$value": "{space.6}"
    },
    "gap": {
      "$type": "dimension",
      "$value": "{space.2}"
    },
    "border": {
      "$type": "dimension",
      "$value": "{border.medium}"
    },
    "weight": {
      "$type": "fontWeight",
      "$value": "{font.weight.semibold}"
    },
    "press-shift": {
      "$type": "dimension",
      "$value": "{border.medium}"
    },
    "lift": {
      "$type": "dimension",
      "$value": "{border.medium}"
    }
  },
  "header": {
    "height": {
      "$type": "dimension",
      "$value": "{size.header}"
    }
  },
  "focus": {
    "width": {
      "$type": "dimension",
      "$value": "{border.thick}"
    },
    "offset": {
      "$type": "dimension",
      "$value": "{border.thick}"
    },
    "color": {
      "$type": "color",
      "$value": "{color.focus.ring}"
    }
  },
  "tag": {
    "padding-block": {
      "$type": "dimension",
      "$value": "{space.1}"
    },
    "padding-inline": {
      "$type": "dimension",
      "$value": "{space.2}"
    },
    "border": {
      "$type": "dimension",
      "$value": "{border.thin}"
    },
    "padding-inline-selectable": {
      "$type": "dimension",
      "$value": "{space.3}"
    },
    "lift": {
      "$type": "dimension",
      "$value": "{border.medium}"
    }
  },
  "card": {
    "gap": {
      "$type": "dimension",
      "$value": "{space.4}"
    }
  },
  "metric": {
    "gap": {
      "$type": "dimension",
      "$value": "{space.1}"
    },
    "rule": {
      "$type": "dimension",
      "$value": "{border.thick}"
    },
    "min": {
      "$type": "dimension",
      "$value": "{size.metric-min}"
    }
  },
  "field": {
    "padding": {
      "$type": "dimension",
      "$value": "{space.3}"
    },
    "border": {
      "$type": "dimension",
      "$value": "{border.medium}"
    },
    "multiline-height": {
      "$type": "dimension",
      "$value": "{size.field-multiline}"
    }
  },
  "icon": {
    "sm": {
      "$type": "dimension",
      "$value": "{size.icon.sm}"
    },
    "md": {
      "$type": "dimension",
      "$value": "{size.icon.md}"
    },
    "stroke": {
      "$type": "number",
      "$value": "{stroke.icon}"
    }
  },
  "media": {
    "reveal-inset": {
      "$type": "dimension",
      "$value": "{space.12}"
    }
  },
  "link": {
    "underline": {
      "$type": "dimension",
      "$value": "{border.thin}"
    },
    "underline-offset": {
      "$type": "dimension",
      "$value": "{space.1}"
    },
    "current-underline": {
      "$type": "dimension",
      "$value": "{border.thick}"
    },
    "weight": {
      "$type": "fontWeight",
      "$value": "{font.weight.semibold}"
    },
    "underline-gap": {
      "$type": "dimension",
      "$value": "{space.1}"
    },
    "bar": {
      "$type": "dimension",
      "$value": "{border.medium}"
    }
  },
  "visually-hidden": {
    "size": {
      "$type": "dimension",
      "$value": "{size.hairline}"
    }
  },
  "hero": {
    "visual-overhang": {
      "$type": "dimension",
      "$value": "{space.32}"
    }
  },
  "phase": {
    "gap": {
      "$type": "dimension",
      "$value": "{space.1}"
    },
    "bar": {
      "$type": "dimension",
      "$value": "{space.2}"
    }
  },
  "cover": {
    "title-size": {
      "$type": "dimension",
      "$value": "{font.size.cover}"
    }
  },
  "notice": {
    "rule": {
      "$type": "dimension",
      "$value": "{border.thick}"
    },
    "padding": {
      "$type": "dimension",
      "$value": "{space.4}"
    }
  },
  "fact-list": {
    "term-width": {
      "$type": "dimension",
      "$value": "{size.decision-term}"
    },
    "term-offset": {
      "$type": "dimension",
      "$value": "{space.1}"
    }
  }
}
