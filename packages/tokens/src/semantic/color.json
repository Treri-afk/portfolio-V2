{
  "color": {
    "surface": {
      "base": {
        "$type": "color",
        "$value": "{color.neutral.25}",
        "$extensions": {
          "portfolio.dark": "{color.neutral.950}"
        }
      },
      "raised": {
        "$type": "color",
        "$value": "{color.neutral.50}",
        "$extensions": {
          "portfolio.dark": "{color.neutral.900}"
        }
      },
      "sunken": {
        "$type": "color",
        "$value": "{color.neutral.100}",
        "$extensions": {
          "portfolio.dark": "{color.neutral.1000}"
        }
      },
      "placeholder": {
        "$type": "color",
        "$value": "{color.neutral.200}",
        "$extensions": {
          "portfolio.dark": "{color.neutral.800}"
        }
      }
    },
    "text": {
      "primary": {
        "$type": "color",
        "$value": "{color.neutral.950}",
        "$extensions": {
          "portfolio.dark": "{color.neutral.25}"
