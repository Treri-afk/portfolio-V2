{
  "responsive": {
    "width": {
      "sm": {
        "$type": "number",
        "$value": "{image.width.sm}"
      },
      "md": {
        "$type": "number",
        "$value": "{image.width.md}"
      },
      "lg": {
        "$type": "number",
        "$value": "{image.width.lg}"
      }
    },
    "sizes": {
      "full": {
        "$type": "other",
        "$value": "{image.span.full}"
      },
      "half": {
        "$type": "other",
        "$value": "(width >= {breakpoint.md}) {image.span.half}, {image.span.full}"
      },
      "third": {
        "$type": "other",
        "$value": "(width >= {breakpoint.lg}) {image.span.third}, (width >= {breakpoint.sm}) {image.span.half}, {image.span.full}"
      },
      "quarter": {
        "$type": "other",
        "$value": "(width >= {breakpoint.lg}) {image.span.quarter}, {image.span.half}"
      }
    }
  }
}
